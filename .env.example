# =============================================================================
# copilot-flow — copy to `.env` and fill values.
#
# Automates the Othership Co-Pilot program across:
#   - Notion (Co-Pilot Applications applicant database)
#   - BigQuery (copilots.copilot_db warehouse table)
#   - Mariana Tek (Admin API — user lookup, discounts, memberships)
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# 1 or true: skip writes to Notion / BigQuery / MT / email
DRY_RUN=1

# Cap onboard job to N pending rows (0 = all)
# ONBOARD_LIMIT=5
# Preview specific people (comma-separated) instead of the pending queue:
# ONBOARD_EMAILS=a@example.com,b@example.com

# Milliseconds between Mariana Tek API calls (rate limiting)
REQUEST_DELAY_MS=100

# -----------------------------------------------------------------------------
# Notion
# -----------------------------------------------------------------------------
# Integration token: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# Co-Pilot Applications database (Applicant Tracker → Co-Pilot Applications)
# https://app.notion.com/p/1ae271660d72805c8a2ccf1ca08fa0cb
NOTION_APPLICATIONS_DATABASE_ID=

# Property names must match the Notion database schema exactly.
NOTION_PROP_NAME=Name
NOTION_PROP_FIRST_NAME=First Name
NOTION_PROP_LAST_NAME=Last Name
NOTION_PROP_EMAIL=Email
NOTION_PROP_STATUS=Status
NOTION_PROP_REGION=Region
NOTION_PROP_SUBMITTED=Submitted
NOTION_PROP_INSTAGRAM_HANDLE=Instagram Handle
NOTION_PROP_INSTAGRAM_FOLLOWING=Instagram Following
NOTION_PROP_PHONE=Phone #
NOTION_PROP_TIKTOK_HANDLE=Tiktok Handle
NOTION_PROP_TIKTOK_FOLLOWING=Tiktok Following
NOTION_PROP_TIKTOK_LINK=Tik Tok Link
NOTION_PROP_YOUTUBE_LINK=YouTube link
NOTION_PROP_YOUTUBE_SUBSCRIBERS=YouTube Subscribers
NOTION_PROP_LINKEDIN_LINK=LinkedIn Link
NOTION_PROP_LINKEDIN_FOLLOWING=LinkedIn Following
NOTION_PROP_TWITTER_HANDLE=Twitter Handle
NOTION_PROP_TWITTER_FOLLOWING=Twitter Following
NOTION_PROP_BLOG_LINK=Blog Link
NOTION_PROP_BLOG_SUBSCRIBERS=Blog Subscribers
NOTION_PROP_CONTENT_TOPICS=Content Topics
NOTION_PROP_MEDIA_KIT=Media Kit

# Optional write-back columns (set when added to the Notion database)
# NOTION_PROP_PREVIOUS_APPLICATION=Previous Application
NOTION_PROP_NEVER_CONSIDER=Never Accept
NOTION_PROP_MT_CLASS_COUNT=MT Class Count
NOTION_PROP_MT_EMAIL=MT Email
NOTION_PROP_MT_HAS_CC=MT Has CC
# NOTION_PROP_MT_HOME_STUDIO=MT Home Studio
NOTION_PROP_INSTAGRAM_FOLLOWERS_SCRAPED=Instagram Following (Scraped)
NOTION_PROP_INSTAGRAM_IS_PUBLIC=Instagram Public
NOTION_PROP_INSTAGRAM_VERIFIED=Instagram Verified
NOTION_PROP_INSTAGRAM_BUSINESS=Instagram Business
NOTION_PROP_INSTAGRAM_POSTS=Instagram Posts
NOTION_PROP_NEEDS_NUDGE=Needs Nudge
NOTION_PROP_NUDGE_REASON=Nudge Reason
NOTION_PROP_LAST_NUDGED=Last Nudged

# Days between Review-tab payment-method nudges (onboard / renew / upgrade / downgrade).
# Applicant onboarding nudges are sent once (Last Nudged set) and never again.
NUDGE_COOLDOWN_DAYS=3

# Onboarded cards edited in this window that have no promo and no MT identity
# are moved back to Evaluated (0 = scan all Onboarded cards)
RECLAIM_ONBOARDED_LOOKBACK_DAYS=30

# -----------------------------------------------------------------------------
# Gmail API (nudge + rejection — Co-Pilot mailbox, separate OAuth from Robbie)
#   npm run gmail-oauth
#   npm run test-gmail -- you@example.com
# -----------------------------------------------------------------------------
EMAIL_SEND_METHOD=gmail_api
EMAIL_FROM=Othership Co-Pilot Program <copilots@othership.us>
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN_COPILOT=
GMAIL_API_USER=me
GMAIL_API_LABEL_NAME=Co-Pilot Applications
# Review / lifecycle (renew, offboard, upgrade, downgrade, freeze, payment nudge, resubmit handles)
GMAIL_API_LABEL_NAME_MANAGEMENT=Co-Pilot Management
GMAIL_API_AUTO_LABEL=1

# Rejection thank-you credit products in Mariana Tek (by applicant Region)
COPILOT_REJECTION_MT_CREDIT_ID_TO=2424
COPILOT_REJECTION_MT_CREDIT_ID_NY=2599
# Legacy single-id fallback if region-specific vars are unset:
# COPILOT_REJECTION_MT_CREDIT_ID=
# COPILOT_REJECTION_MT_CREDIT_AMOUNT=1
# COPILOT_REJECTION_MT_CREDIT_EXPIRY_DAYS=30

NOTION_PROP_NEEDS_NUDGE=Needs Nudge
NOTION_PROP_NUDGE_REASON=Nudge Reason
NOTION_PROP_LAST_NUDGED=Last Nudged
NOTION_PROP_CREDIT_APPLIED=Credit Applied
NOTION_PROP_REONBOARD=Re-onboard
# Select options: job sets Needs review; ops sets Proceed or Decline
# NOTION_REONBOARD_NEEDS_REVIEW=Needs review
# NOTION_REONBOARD_PROCEED=Proceed
# NOTION_REONBOARD_DECLINE=Decline

# Status values used by the application pipeline (must match Notion status options)
NOTION_STATUS_NEW=No Status
NOTION_STATUS_EVALUATED=Evaluated
NOTION_STATUS_ACCEPTED=Accepted
NOTION_STATUS_REJECTED=Rejected
NOTION_STATUS_DUPLICATE=Duplicate
NOTION_STATUS_ACCEPTED_CONTACTED=Accepted - Contacted
NOTION_STATUS_REJECTED_CONTACTED=Rejected - Contacted
NOTION_STATUS_ONBOARDED=Onboarded

# Optional: only process applications submitted within this many days (0 = no limit)
# APPLICATION_LOOKBACK_DAYS=7

# -----------------------------------------------------------------------------
# BigQuery (co-pilot DB)
# -----------------------------------------------------------------------------
# Service account JSON path for Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=

# GCP project that hosts the copilots dataset
BQ_PROJECT_ID=data-dashboard-463217

# Defaults match existing os-mt-services / email-automations conventions
BQ_DATASET=copilots
BQ_APPLICANTS_TABLE=copilot_applicants
BQ_COPILOT_TABLE=copilot_db
BQ_COPILOT_MEMBERSHIPS_TABLE=copilot_memberships

# Sheet sync (npm run sync-copilot-db) reads raw_to_* / raw_nyc_* external tables
# and MERGEs into copilot_db, then looks up missing MT user_id by email (then name).
# Requires a credential that can access the linked Drive sheets.

# BigQuery job location (must match dataset location)
BQ_QUERY_LOCATION=US

# -----------------------------------------------------------------------------
# Mariana Tek (Admin API)
# -----------------------------------------------------------------------------
MT_API_BASE_URL=https://othership.marianatek.com/api
MT_API_KEY=

# Partner IDs by region (used for membership assignment)
MT_PARTNER_ID_NY=
MT_PARTNER_ID_TO=

# Home-studio location IDs (used to resolve NY vs TO region)
MT_LOCATION_ID_YORKVILLE=48750
MT_LOCATION_ID_ADELAIDE=48717
MT_LOCATION_ID_FLATIRON=48784
MT_LOCATION_ID_WILLIAMSBURG=48817

# Co-Pilot discount percentages by tier (defaults match os-mt-services)
# COPILOT_SEEKER_DISCOUNT_PERCENT=11
# COPILOT_WAYFINDER_DISCOUNT_PERCENT=14
# COPILOT_LUMINARY_DISCOUNT_PERCENT=18

# -----------------------------------------------------------------------------
# Social enrichment (Instagram follower count)
# -----------------------------------------------------------------------------
# none | apify
SOCIAL_ENRICHMENT_PROVIDER=none

# Apify — https://console.apify.com/account/integrations
# Required when SOCIAL_ENRICHMENT_PROVIDER=apify (~$1.60 / 1k profiles)
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
APIFY_WAIT_SECS=300

# Icon thresholds:
# 🔴 = scraped < 1500, OR form followers clearly inflated vs scrape
# 🟢 = scraped ≥ 1500 + public + MT account + valid CC
# 🟡 = scraped ≥ 1500 + public, but missing MT and/or CC
QUALIFIED_MIN_FOLLOWERS=1500

# Smoke test one or more handles (batched in a single Apify run):
#   npm run test-apify -- nasa
#   npm run test-apify -- nasa humansofny bathhouse

# MT admin host used for mt_profile_link
# MT_TENANT_HOST=othership.marianatek.com

# -----------------------------------------------------------------------------
# Christine evaluation sheet — ops workbook "Copilot base"
# https://docs.google.com/spreadsheets/d/1m0WKULiG6unH9wicoNKWp3aI5b6MJcm74k745AlWzFI
# Job creates the Review tab; does not write NYC_Seeker / other ops tabs.
# Queue window (7 days + already expired) lives in bq/copilot_evaluation_queue.sql
# -----------------------------------------------------------------------------
EVALUATION_SHEET_ID=1m0WKULiG6unH9wicoNKWp3aI5b6MJcm74k745AlWzFI
# EVALUATION_SHEET_REVIEW_TAB=Review
# EVALUATION_SHEET_ADD_TO_MODASH_TAB=Add to Modash
# Rebuild Review without ingesting/applying filled decisions:
# EVALUATE_SKIP_APPLY=1
# Dry-run (or apply) only specific Review rows:
# EVALUATE_EMAILS=a@example.com

# One-time: email active copilots with a live Co-Pilot membership whose IG is re-submit
#   DRY_RUN=1 npm run email-resubmit-handles
#   EMAILS=a@example.com LIMIT=5 DRY_RUN=1 npm run email-resubmit-handles
#   DRY_RUN=0 npm run email-resubmit-handles -- --apply
# EMAILS=
# LIMIT=

# Optional override for the shared Webflow offer page prefix
# COPILOT_OFFER_LINK_PREFIX=https://othership.us/copilot/intro-offer?id=

# Application form linked from the email signoff ("Send them here to apply")
COPILOT_APPLY_URL=https://tally.so/r/mDVGpq

# Breathwork app offer in the onboarding (acceptance) email
COPILOT_BREATHWORK_COMMUNITY_URL=https://apps.apple.com/redeem?ctx=offercodes&id=1590348936&code=COPILOT1

# Optional Hub links used in upgrade / downgrade emails
# COPILOT_SEEKER_HUB_URL=https://app.notion.com/p/othership/Seeker-Hub-299271660d72803d8291e80032fdff4c
# COPILOT_WAYFINDER_HUB_URL=https://app.notion.com/p/othership/Wayfinder-Hub-299271660d7280398958ed331855e188
# COPILOT_LUMINARY_HUB_URL=https://app.notion.com/p/othership/Luminary-Hub-299271660d7280f0be49fa910625ecc4

# --- assign-memberships job ---
# EMAILS_FILE=seeker_emails.txt
# DRY_RUN=1 skips checkout; still requires a valid stored bankcard to count as assignable
# RESERVATION_CUTOFF_DATE=2025-12-01
# RESERVATION_OUTPUT_FILE=./future_reservations.txt
